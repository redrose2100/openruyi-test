# 与 Shfmt/Prettier 配合
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 4

# 无扩展名的 shell 可执行脚本（如 run_embedded）不会被上面的通配段匹配，
# shfmt 会退回默认 tab；如需保留项目缩进风格，按文件名单独声明：
# [testcases/embedded-test/third_party_packages_test/oe_test_shadow_test_001/run_embedded]
# indent_style = tab
# indent_size = 4

[*.{js,jsx,ts,tsx,json,md,yaml,yml}]
indent_style = space
indent_size = 2
