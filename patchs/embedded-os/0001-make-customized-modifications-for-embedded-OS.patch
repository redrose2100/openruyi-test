diff --git a/testcases/embedded-test/os_basic_extra_test/oe_test_initscripts_test_001/oe_test_initscripts_test_001.sh b/testcases/embedded-test/os_basic_extra_test/oe_test_initscripts_test_001/oe_test_initscripts_test_001.sh
index c4a94f69c..ea8cc36ca 100644
--- a/testcases/embedded-test/os_basic_extra_test/oe_test_initscripts_test_001/oe_test_initscripts_test_001.sh
+++ b/testcases/embedded-test/os_basic_extra_test/oe_test_initscripts_test_001/oe_test_initscripts_test_001.sh
@@ -20,6 +20,11 @@ source "$OET_PATH/libs/locallibs/common_lib.sh"
 
 function run_test() {
     LOG_INFO "Start to run initscripts test."
+    # 检测到系统中存在systemctl则直接退出测试
+    if command -v systemctl >/dev/null 2>&1; then
+        LOG_INFO "系统中存在systemctl，退出initscripts测试"
+        return 0
+    fi
     ifconfig | grep "^lo"
     CHECK_RESULT $? 0 0 "check ifdown failed!"
     ifdown lo
diff --git a/testcases/embedded-test/os_basic_extra_test/oe_test_net-tools_test_001/oe_test_net-tools_test_001.sh b/testcases/embedded-test/os_basic_extra_test/oe_test_net-tools_test_001/oe_test_net-tools_test_001.sh
index 2d73faa7b..9a2f0cbf3 100644
--- a/testcases/embedded-test/os_basic_extra_test/oe_test_net-tools_test_001/oe_test_net-tools_test_001.sh
+++ b/testcases/embedded-test/os_basic_extra_test/oe_test_net-tools_test_001/oe_test_net-tools_test_001.sh
@@ -74,13 +74,13 @@ function run_test() {
 
     route
     CHECK_RESULT $? 0 0 "check route failed!"
-    route add default gw "${NODE1_IPV4}" && route | grep "${NODE1_IPV4}"
+    route add default gw "${NODE1_IPV4}" && route -n | grep "${NODE1_IPV4}"
     CHECK_RESULT $? 0 0 "check route failed!"
     route -n | grep -v "default" | grep "0.0.0.0"
     CHECK_RESULT $? 0 0 "check route -n failed!"
     route -e | grep -E "irtt|MSS|Window" 
     CHECK_RESULT $? 0 0 "check route -e failed!"
-    route del default gw "${NODE1_IPV4}" && route | grep -v "${NODE1_IPV4}"
+    route del default gw "${NODE1_IPV4}" && route -n | grep -v "${NODE1_IPV4}"
     CHECK_RESULT $? 0 0 "check route failed!"
     LOG_INFO "End to run net-tools test."
 }
diff --git a/testcases/embedded-test/os_basic_tests/oe_test_system_service_sshd/oe_test_system_service_sshd.sh b/testcases/embedded-test/os_basic_tests/oe_test_system_service_sshd/oe_test_system_service_sshd.sh
index bb35693c1..bd4309661 100644
--- a/testcases/embedded-test/os_basic_tests/oe_test_system_service_sshd/oe_test_system_service_sshd.sh
+++ b/testcases/embedded-test/os_basic_tests/oe_test_system_service_sshd/oe_test_system_service_sshd.sh
@@ -23,14 +23,26 @@ function run_test() {
     LOG_INFO "Start to run test."
 
     for ((i = 1; i < 10; i ++)); do
-        /etc/init.d/sshd stop
-        CHECK_RESULT $? 0 0 "stop sshd fail"
-        /etc/init.d/sshd start
-        CHECK_RESULT $? 0 0 "start sshd fail"
-	SLEEP_WAIT 2
-        /etc/init.d/sshd restart
-        CHECK_RESULT $? 0 0 "restart sshd fail"
-        SLEEP_WAIT 2
+        # 如果不是systemd文件管理系统，执行额外的停止和启动检查
+        if ! command -v systemctl &>/dev/null; then
+            /etc/init.d/sshd stop
+            CHECK_RESULT $? 0 0 "stop sshd fail"
+            /etc/init.d/sshd start
+            CHECK_RESULT $? 0 0 "start sshd fail"
+            SLEEP_WAIT 2
+            /etc/init.d/sshd restart
+            CHECK_RESULT $? 0 0 "restart sshd fail"
+            SLEEP_WAIT 2
+        else
+            systemctl stop sshd
+            CHECK_RESULT $? 0 0 "stop sshd fail"
+            systemctl start sshd
+            CHECK_RESULT $? 0 0 "start sshd fail"
+            SLEEP_WAIT 2
+            systemctl restart sshd
+            CHECK_RESULT $? 0 0 "restart sshd fail"
+            SLEEP_WAIT 2
+        fi
     done
 
     LOG_INFO "End to run test."
@@ -39,7 +51,14 @@ function run_test() {
 function post_test() {
     LOG_INFO "Start to restore the test environment."
 
-    /etc/init.d/sshd restart
+    # 如果不是systemd文件管理系统，执行额外的重启检查
+    if ! command -v systemctl &>/dev/null; then
+        /etc/init.d/sshd restart
+        CHECK_RESULT $? 0 0 "restart sshd fail"
+    else
+        systemctl restart sshd
+        CHECK_RESULT $? 0 0 "restart sshd fail"
+    fi
 
     LOG_INFO "End to restore the test environment."
 }
