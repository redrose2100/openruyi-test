source ${OET_PATH}/libs/locallibs/common_lib.sh
function pre_test() {
    LOG_INFO "Start environmental preparation."
    cp /etc/pam.d/sudo /etc/pam.d/sudo-pam
    echo "auth sufficient pam_rootok.so">/etc/pam.d/sudo

    useradd xtest>/tmp/null 2>&1
    echo xtest:123| chpasswd  

    useradd xxtest>/tmp/null 2>&1
    echo    xxtest:123| chpasswd  


    LOG_INFO "End of environmental preparation!"
}

function run_test() {
    LOG_INFO "Start testing..."
    SSH_CMD  "sudo dnf install vim;" 127.0.0.1  123 xtest  20 22
    if [ "$?" == "0" ]; then
    	varflag="0"
    else
	varflag=1
    fi
    CHECK_RESULT $varflag "0"
    LOG_INFO "Finish test!"
}

function post_test(){
	echo "hello"
    cp  /etc/pam.d/sudo-pam /etc/pam.d/sudo
}
main "$@"
