source ${OET_PATH}/libs/locallibs/common_lib.sh
function pre_test() {
    LOG_INFO "Start environmental preparation."

    cp /etc/pam.d/sshd   /etc/pam.d/sshd_bak
    cp /etc/pam.d/login /etc/pam.d/login_bak 
    cp /etc/ssh/deniedusers /etc/ssh/deniedusers_bak
   
    echo "auth required pam_listfile.so onerr=succeed item=user sense=deny file=/etc/ssh/deniedusers" >> /etc/pam.d/sshd 
    echo "auth required pam_listfile.so onerr=succeed item=user sense=deny file=/etc/ssh/deniedusers" >> /etc/pam.d/login 
    echo "root" >> /etc/ssh/deniedusers 
    chmod 600 /etc/ssh/deniedusers 

    LOG_INFO "End of environmental preparation!"
}

function run_test() {
    LOG_INFO "Start testing..."
    SSH_CMD "echo hello;" 127.0.0.1  123 root  20 22
    if [ "$?" == "0" ]; then
    	varflag="0"
    else
	varflag=1
    fi
    CHECK_RESULT $varflag "0"
    LOG_INFO "Finish test!"
}

function post_test(){
	echo "hello"
     cp /etc/pam.d/sshd_bak  /etc/pam.d/sshd   
     cp /etc/pam.d/login_bak  /etc/pam.d/login 
     cp /etc/ssh/deniedusers_bak  /etc/ssh/deniedusers 
}
main "$@"
