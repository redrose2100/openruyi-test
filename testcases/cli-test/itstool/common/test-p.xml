<?xml version="1.0"?>
<doc its:version="2.0" xmlns:its="http://www.w3.org/2005/11/its">
  <its:rules version="2.0">
    <its:param name="param_name">default_value</its:param>
    <its:translateRule selector="/doc" translate="no"/>
    <its:translateRule selector="//msg[@lcid=$param_name]" translate="yes"/>
  </its:rules>
  <msg lcid="default_value" num="1">content of default_value</msg>
  <msg lcid="value1" num="1">content of value1</msg>
  <msg lcid="value2" num="1">content of value2</msg>
  <msg lcid="value3" num="1">content of value3</msg>
</doc>
