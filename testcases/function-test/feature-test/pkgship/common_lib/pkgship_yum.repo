[openEuler-Source]
name=openEuler-Source
baseurl=https://repo.openeuler.org/openEuler-20.03-LTS/source
enabled=1
gpgcheck=0
priority=1

[openEuler-Binary]
name=openEuler-Binary
baseurl=https://repo.openeuler.org/openEuler-20.03-LTS/everything/$basearch
enabled=1
gpgcheck=0
priority=2

[fedora-Source]
name=fedora-Source
baseurl=https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/34/Everything/source/tree
enabled=1
gpgcheck=0
priority=3

[fedora-Binary]
name=fedora-Binary
baseurl=https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/34/Everything/$basearch/os/
enabled=1
gpgcheck=0
priority=4
