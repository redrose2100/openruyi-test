<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type='kvm'>
  <name>2u2g_memlink_fpr_proportion</name>
  <memory unit='GiB'>2</memory>
  <memoryBacking>
    <hugepages>
      <page size='2' unit='MiB'/>
    </hugepages>
    <allocation mode='hugepage-ondemand'/>
  </memoryBacking>
  <vcpu placement='static'>2</vcpu>
  <cputune>
    <vcpupin cpuset='5' vcpu='0'/>
    <vcpupin cpuset='6' vcpu='1'/>
    <emulatorpin cpuset='4-7'/>
  </cputune>
  <numatune>
    <memory mode='strict' nodeset='0,2'/>
    <memnode cellid='0' mode='preferred' nodeset='0' proportion='768-node0:256-node2'/>
    <memnode cellid='1' mode='preferred' nodeset='2' proportion='512-node0:512-node2'/>
  </numatune>
  <cpu mode='host-passthrough' check='none'>
    <topology sockets='1' cores='2' threads='1'/>
    <numa>
      <cell id='0' cpus='0' memory='1' unit='GiB'/>
      <cell id='1' cpus='1' memory='1' unit='GiB'/>
    </numa>
  </cpu>
  <os>
    <type arch='aarch64' machine='virt'>hvm</type>
    <loader readonly='yes' type='pflash'>/usr/share/edk2/aarch64/QEMU_EFI-pflash.raw</loader>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <gic version='3'/>
  </features>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup' track='guest'/>
    <timer name='hpet' present='no'/>
    <timer name='pit' tickpolicy='delay'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-kvm</emulator>
    <controller type='scsi' model='virtio-scsi' index='0'/>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native'/>
      <source file='IMAGE_PATH'/>
      <target dev='sda' bus='scsi'/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>
    <interface type='bridge'>
      <mac address='52:54:00:3f:de:d6'/>
      <source bridge='br0'/>
      <target dev='vnet0'/>
      <model type='virtio'/>
      <alias name='net0'/>
    </interface>
    <graphics type='vnc' port='5900' autoport='yes' listen='0.0.0.0'>
      <listen type='address' address='0.0.0.0'/>
    </graphics >
    <controller type='usb' index='0' model='ehci'/>
    <controller type='pci' index='0' model='pcie-root'/>
    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='usb'/>
    <serial type='pty'/>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <memballoon model='virtio' freePageReporting='on' autodeflate='on'/>
  </devices>
</domain>
