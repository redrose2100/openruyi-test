#!/usr/bin/expect

set vm_name [lindex $argv 0]
set username "root"
set password "openEuler12#$"
set timeout 120

spawn virsh console $vm_name
expect {
    "Ctrl + ]" { send "\r" }
    timeout { send "\r" }
}

set max_attempts 120
set timeout 10
for {set i 0} {$i < $max_attempts} {incr i} {
    expect {
        "*login:" { 
            send "$username\r" 
            break
        }
        "# " {
            send "echo 'Already logged in.'\r" 
            break
        }
        timeout { 
            if {$i % 6 == 0} {
                send "\r"
            }
            continue
        }
    }
}
if {$i == $max_attempts} {
    send_user "Timeout waiting for login\n"
    exit 1
}

expect "*assword:" { send "$password\r" }
after 10000

set timeout 120

expect "# "
send "grep -q '^PermitRootLogin' /etc/ssh/sshd_config\r"
expect "# "
send "echo $?\r"
expect {
    -re "0\r\n.*# " {
        send "echo 'PermitRootLogin is not commented out, skipping configuration.'\r"
        expect "# "
    }
    -re "1\r\n.*# " {
        send "/bin/cp -f /etc/ssh/sshd_config /etc/ssh/sshd_config_bak\r"
        expect "# "
        send "echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config\r"
        expect "# "
        send "grep 'PermitRootLogin' /etc/ssh/sshd_config\r"
        expect "# "
        send "systemctl restart sshd\r"
        expect "# "
    }
}

send "ip addr show eth0 | grep -q '192.168.1.101'\r"
expect "# "
send "echo $?\r"
expect {
    -re "0\r\n.*# " {
        send "echo 'IP 192.168.1.101 already exists on eth0, skipping configuration.'\r"
        expect "# "
    }
    -re "1\r\n.*# " {
        send "echo -e \"DEVICE=eth0\nBOOTPROTO=static\nONBOOT=yes\nIPADDR=192.168.1.101\nNETMASK=255.255.255.0\nGATEWAY=192.168.1.1\nDNS1=8.8.8.8\" > /etc/sysconfig/network-scripts/ifcfg-eth0\r"
        expect "# "
        send "reboot\r"
        after 10000
    }
}

send "\x1d"
expect ">" {
    send "c\r"
    expect eof
}
